# Streamlit Community Cloud secrets template
# -----------------------------------------------------------------------------
# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml to Git — it is listed in .gitignore.
#
# On Streamlit Community Cloud, add these under:
#   App settings → Secrets
# -----------------------------------------------------------------------------

# The shared secret that the Streamlit app sends to POST /explain.
# Must match SENTINEL_API_KEY set on the FastAPI server.
SENTINEL_API_KEY = "replace-with-your-real-sentinel-api-key"

# Base URL of the deployed FastAPI backend.
# For local development: http://localhost:8000
# For Render deployment: https://your-app-name.onrender.com
SENTINELML_API_BASE_URL = "http://localhost:8000"
